#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ZARYA_VERSION_MAJOR@,@ZARYA_VERSION_MINOR@,@ZARYA_VERSION_PATCH@,0
 PRODUCTVERSION @ZARYA_VERSION_MAJOR@,@ZARYA_VERSION_MINOR@,@ZARYA_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "vladon.dev\0"
            VALUE "FileDescription", "@ZARYA_WINDOWS_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@ZARYA_VERSION_STRING@\0"
            VALUE "InternalName", "@ZARYA_WINDOWS_ORIGINAL_FILENAME@\0"
            VALUE "LegalCopyright", "Copyright (C) Vladislav Yaroslavlev\0"
            VALUE "OriginalFilename", "@ZARYA_WINDOWS_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "Zarya\0"
            VALUE "ProductVersion", "@ZARYA_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
