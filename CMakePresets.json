{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-homebrew",
      "displayName": "macOS (Homebrew Qt, Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": {
          "type": "PATH",
          "value": "/opt/homebrew/opt/qt@6;/usr/local/opt/qt@6"
        },
        "ZARYA_STATIC_QT": "OFF"
      }
    },
    {
      "name": "windows-msvc2026",
      "displayName": "Windows MSVC 2026 (Qt shared)",
      "inherits": "windows-base",
      "cacheVariables": {
        "ZARYA_STATIC_QT": "OFF"
      }
    },
    {
      "name": "windows-msvc2026-static",
      "displayName": "Windows MSVC 2026 (Qt static)",
      "inherits": "windows-base",
      "cacheVariables": {
        "ZARYA_STATIC_QT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-homebrew-release",
      "configurePreset": "macos-homebrew",
      "configuration": "Release",
      "targets": ["zarya"]
    },
    {
      "name": "windows-msvc2026-release",
      "configurePreset": "windows-msvc2026",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc2026-static-release",
      "configurePreset": "windows-msvc2026-static",
      "configuration": "Release",
      "targets": ["zarya"]
    },
    {
      "name": "windows-msvc2026-debug",
      "configurePreset": "windows-msvc2026",
      "configuration": "Debug"
    },
    {
      "name": "zarya-xray-config-test",
      "configurePreset": "windows-msvc2026",
      "configuration": "Release",
      "targets": ["zarya_xray_config_test"]
    }
  ]
}
